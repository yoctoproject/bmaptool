#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Entry point for the bmaptool command installed by the RPM."""

import sys

# The package is installed outside the interpreter's default sys.path so that
# it works with any Python 3.x (3.6, 3.9, ...), not only with the version used
# to build the RPM.
sys.path.insert(0, "/usr/lib/bmaptool")

from bmaptool.CLI import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
